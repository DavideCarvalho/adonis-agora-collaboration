{
  "name": "@adonis-agora/collaboration",
  "version": "0.1.1",
  "description": "Collaborative editing (CRDT) for AdonisJS 7 — Yjs (Hocuspocus) and Automerge drivers, Redis-backed presence, unified version control. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-collaboration.git",
    "directory": "packages/adonis"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./types": {
      "types": "./dist/src/types.d.ts",
      "import": "./dist/src/types.js",
      "default": "./dist/src/types.js"
    },
    "./drivers/yjs": {
      "types": "./dist/src/drivers/yjs/yjs_driver.d.ts",
      "import": "./dist/src/drivers/yjs/yjs_driver.js",
      "default": "./dist/src/drivers/yjs/yjs_driver.js"
    },
    "./drivers/automerge": {
      "types": "./dist/src/drivers/automerge/automerge_driver.d.ts",
      "import": "./dist/src/drivers/automerge/automerge_driver.js",
      "default": "./dist/src/drivers/automerge/automerge_driver.js"
    },
    "./storage/file_system": {
      "types": "./dist/src/storage/file_system_storage.d.ts",
      "import": "./dist/src/storage/file_system_storage.js",
      "default": "./dist/src/storage/file_system_storage.js"
    },
    "./storage/lucid": {
      "types": "./dist/src/storage/lucid_storage.d.ts",
      "import": "./dist/src/storage/lucid_storage.js",
      "default": "./dist/src/storage/lucid_storage.js"
    },
    "./services/main": {
      "types": "./dist/src/services/main.d.ts",
      "import": "./dist/src/services/main.js",
      "default": "./dist/src/services/main.js"
    },
    "./collaboration_provider": {
      "types": "./dist/providers/collaboration_provider.d.ts",
      "import": "./dist/providers/collaboration_provider.js",
      "default": "./dist/providers/collaboration_provider.js"
    },
    "./configure": {
      "types": "./dist/configure.d.ts",
      "import": "./dist/configure.js",
      "default": "./dist/configure.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run copy:stubs",
    "check:dist": "node ../../scripts/assert-build-output.mjs dist src/index.js",
    "clean": "rm -rf dist",
    "copy:stubs": "mkdir -p dist/stubs/config && cp stubs/main.ts dist/stubs/main.js && cp stubs/config/collaboration.stub dist/stubs/config/collaboration.stub",
    "prepack": "pnpm run check:dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@automerge/automerge": "^3.4.1",
    "@hocuspocus/server": "^4.6.0",
    "@hocuspocus/transformer": "^4.6.0",
    "ioredis": "^5.11.1",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.27"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/lucid": "^22.4.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/core": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.5.0",
    "@adonisjs/core": "7.5.0",
    "@adonisjs/lucid": "22.4.2",
    "@swc/core": "1.15.47",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.11",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "crdt",
    "yjs",
    "automerge",
    "collaboration",
    "websocket",
    "realtime",
    "agora"
  ]
}
