import { BaseSchema } from '@adonisjs/lucid/schema'

export default class extends BaseSchema {
  protected tableName = '{{ migration.tableName }}'
  /** Postgres schema for the table (schema in lucidStorage); empty = the connection's current one. */
  protected schemaName = '{{ migration.schema }}'

  async up() {
    // Postgres only; on MySQL the schema is a database you create yourself.
    if (this.schemaName && this.db.dialect.name === 'postgres') {
      this.schema.createSchemaIfNotExists(this.schemaName)
    }
    this.schema.withSchema(this.schemaName).createTable(this.tableName, (table) => {
      table.string('doc_name').notNullable()
      table.string('id').notNullable()
      table.string('created_by').nullable()
      table.string('label').nullable()
      table.integer('seq').notNullable()
      // The document's bytes at the moment the version was created.
      table.binary('snapshot').nullable()
      table.timestamp('created_at', { useTz: true })

      table.primary(['doc_name', 'id'])
      table.index(['doc_name', 'seq'])
    })
  }

  async down() {
    this.schema.withSchema(this.schemaName).dropTable(this.tableName)
  }
}
