/**
 * Worker PartyKit do @adonis-agora/collaboration (edge sync).
 *
 * Um Durable Object por room (= docName). Os browsers conectam AQUI, direto
 * — the WebSocket traffic does not pass through the Adonis server. This
 * worker speaks the binary y-protocols and exposes an HTTP endpoint
 * (`onRequest`) that
 * o PartyKitDriver no Adonis consome pra estado/texto/restore.
 *
 * Deploy: npx partykit deploy (config em partykit.toml)
 *
 * Worker protocol v2 (@adonis-agora/collaboration). Only COLLAB_JWT_SECRET and
 * ADONIS_BASE_URL are needed: the other keys are derived from it (HKDF), with
 * the same constants as `src/auth/partykit_keys.ts` in the package.
 *  - browser tokens (`onConnect`) are signed with COLLAB_JWT_SECRET and carry
 *    `canWrite`; without it the socket is read-only;
 *  - the HTTP API (`onRequest`) only accepts tokens signed with the derived
 *    server key, i.e. minted by Adonis for itself — never a browser token;
 *  - persisting back to Adonis sends the derived worker secret, never the
 *    JWT signing key. COLLAB_WORKER_SECRET overrides it only when Adonis sets
 *    `partykit.workerSecret` to the same value.
 * A worker generated from an older template must be regenerated and redeployed.
 */
import { onConnect } from 'y-partykit';
import type { PartyConnection, PartyConnectionContext, PartyRequest, PartyServer } from 'partykit/server';
import * as Y from 'yjs';

/** JWT payload issued by Adonis (GET /collaboration/token route). */
interface CollabToken {
  userId: string;
  docName: string;
  exp: number;
  /** `authorize`'s canWrite at issue time. Absent = read-only. */
  canWrite?: boolean;
}

/** Identity the Adonis PartyKitDriver signs its own calls with. */
const SERVER_IDENTITY = 'adonis-server';
/** Identity this worker signs its state reads from Adonis with. */
const WORKER_IDENTITY = 'partykit-worker';

// Keep in step with src/auth/partykit_keys.ts in @adonis-agora/collaboration.
const HKDF_SALT = '@adonis-agora/collaboration:partykit';
const WORKER_SECRET_LABEL = 'worker-secret:v1';
const SERVER_KEY_LABEL = 'server-token:v1';

const derivedKeys = new Map<string, Promise<string>>();
let warnedLegacyWorkerSecret = false;

/** HKDF-SHA256(secret, salt, label) → 32 bytes, base64url — as Node's `hkdfSync`. */
function deriveKey(secret: string, label: string): Promise<string> {
  const cacheKey = `${label}\u0000${secret}`;
  let derived = derivedKeys.get(cacheKey);
  if (!derived) {
    derived = (async () => {
      const encoder = new TextEncoder();
      const ikm = await crypto.subtle.importKey('raw', encoder.encode(secret), 'HKDF', false, [
        'deriveBits',
      ]);
      const bits = await crypto.subtle.deriveBits(
        { name: 'HKDF', hash: 'SHA-256', salt: encoder.encode(HKDF_SALT), info: encoder.encode(label) },
        ikm,
        256,
      );
      return Buffer.from(bits).toString('base64url');
    })();
    derivedKeys.set(cacheKey, derived);
  }
  return derived;
}

/**
 * Signature + expiry + **document binding**.
 *
 * `expectedDocName` is not optional decoration: the room IS the document, and
 * a token is issued for one document only. Without this comparison a token
 * legitimately obtained for a document the caller may read would open every
 * other room on the worker — the client picks the room, the server only
 * checked that the signature was ours.
 */
async function verifyToken(
  token: string | null,
  secret: string,
  expectedDocName: string,
): Promise<CollabToken | null> {
  // No secret configured: refuse everything. Verifying with an empty key would
  // accept any token its holder signed with an empty key.
  if (!token || !secret) return null;
  const parts = token.split('.');
  if (parts.length !== 3) return null;
  const [header, body, signature] = parts as [string, string, string];
  const key = await crypto.subtle.importKey(
    'raw',
    new TextEncoder().encode(secret),
    { name: 'HMAC', hash: 'SHA-256' },
    false,
    ['verify'],
  );
  const valid = await crypto.subtle.verify(
    'HMAC',
    key,
    Buffer.from(signature, 'base64url'),
    new TextEncoder().encode(`${header}.${body}`),
  );
  if (!valid) return null;
  try {
    const parsed = JSON.parse(Buffer.from(body, 'base64url').toString()) as CollabToken;
    // `exp` is required, as in `verifyCollabToken`: a payload without it would never expire.
    if (!parsed.userId || !parsed.docName || typeof parsed.exp !== 'number') return null;
    if (parsed.exp * 1000 < Date.now()) return null;
    if (parsed.docName !== expectedDocName) return null;
    return parsed;
  } catch {
    return null;
  }
}

/**
 * HS256 JWT `{ userId: 'partykit-worker', docName }`, valid for one minute,
 * signed with the worker secret — how this worker proves itself to
 * `GET /collaboration/state` without sending the secret, and only for the
 * room it is loading.
 */
async function signWorkerToken(secret: string, docName: string): Promise<string> {
  const encode = (value: object) => Buffer.from(JSON.stringify(value)).toString('base64url');
  const now = Math.floor(Date.now() / 1000);
  const unsigned = `${encode({ alg: 'HS256', typ: 'JWT' })}.${encode({
    userId: WORKER_IDENTITY,
    docName,
    iat: now,
    exp: now + 60,
  })}`;
  const key = await crypto.subtle.importKey(
    'raw',
    new TextEncoder().encode(secret),
    { name: 'HMAC', hash: 'SHA-256' },
    false,
    ['sign'],
  );
  const signature = await crypto.subtle.sign('HMAC', key, new TextEncoder().encode(unsigned));
  return `${unsigned}.${Buffer.from(signature).toString('base64url')}`;
}

/**
 * The room being addressed, read from the URL: `/parties/<party>/<room>`.
 *
 * Taken from the path rather than from the token, obviously — the whole point
 * is to compare the two. Rejoined because a document name contains slashes
 * (`researches/42/writing`) and travels percent-encoded in that last segment.
 */
function roomFromUrl(url: string): string {
  const segments = new URL(url).pathname.split('/').slice(3).filter(Boolean);
  return decodeURIComponent(segments.join('/'));
}

export default class CollabParty implements PartyServer {
  /** Doc vivo do room — populado pelo primeiro ciclo load/callback. */
  private liveDoc?: Y.Doc;

  constructor(public party: import('partykit/server').Party) {}

  static async onBeforeConnect(request: PartyRequest, lobby: { context: PartyConnectionContext }) {
    const secret = lobby.context.party.env.COLLAB_JWT_SECRET as string | undefined;
    const token = new URL(request.url).searchParams.get('token');
    const claims = await verifyToken(token, secret ?? '', roomFromUrl(request.url));
    if (!claims) {
      return new Response('invalid or expired token', { status: 401 });
    }
    return request;
  }

  async onConnect(connection: PartyConnection, ctx: PartyConnectionContext) {
    // Verified again here rather than trusting headers forwarded from
    // onBeforeConnect: the permission must come from the signed token, and a
    // header is something a client can send too.
    const claims = await verifyToken(
      new URL(ctx.request.url).searchParams.get('token'),
      (this.party.env.COLLAB_JWT_SECRET as string | undefined) ?? '',
      this.docName,
    );
    if (!claims) {
      connection.close(4401, 'invalid or expired token');
      return;
    }
    await onConnect(connection, this.party, {
      // A reader's socket still receives updates and awareness, but every
      // Yjs update it sends is dropped — it never reaches the doc, the DO
      // storage or Adonis. Only an explicit `canWrite: true` writes.
      readOnly: claims.canWrite !== true,
      // Debounced persistence into DO storage; large docs should use the
      // history mode (10 MB cap) — tune for your workload.
      persist: { mode: 'snapshot' },
      load: async () => {
        // Initial state: fetch the authoritative snapshot from Adonis
        // (source of truth for versions). Falls back to empty.
        // 404 means nothing is stored yet; anything else non-2xx is a
        // misconfiguration, and Adonis's answer says how to fix it.
        try {
          const response = await this.fetchFromAdonis(`/collaboration/state`);
          if (!response.ok) {
            if (response.status !== 404) {
              console.error(
                `[collab-worker] loading "${this.docName}" from Adonis failed (${response.status}): ${await response.text()}`,
              );
            }
            return Y.encodeStateAsUpdate(new Y.Doc());
          }
          return new Uint8Array(await response.arrayBuffer());
        } catch {
          return Y.encodeStateAsUpdate(new Y.Doc());
        }
      },
      callback: {
        handler: async (doc: Y.Doc) => {
          // Keep the reference so onRequest serves real state/text.
          this.liveDoc = doc;
          // Post-debounce persistence back to Adonis.
          try {
            await this.fetchFromAdonis('/collaboration/state', {
              method: 'POST',
              body: Y.encodeStateAsUpdate(doc),
            });
          } catch {
            // Transient failure: local DO storage already ensured durability.
          }
        },
        debounceWait: 2000,
        debounceMaxWait: 10000,
      },
    });
  }

  /**
   * HTTP API consumed by the PartyKitDriver (Adonis side) — and only by it.
   *
   * Requires a token signed with the server key derived from
   * COLLAB_JWT_SECRET, which Adonis never uses for a browser token. A user's
   * token (even a writer's, even one whose userId is "adonis-server") is
   * refused: POST applies an arbitrary update to the room.
   */
  async onRequest(request: PartyRequest): Promise<Response> {
    const secret = this.party.env.COLLAB_JWT_SECRET as string | undefined;
    if (!secret) return new Response('unauthenticated', { status: 401 });
    const serverKey = await deriveKey(secret, SERVER_KEY_LABEL);
    const claims = await verifyToken(
      request.headers.get('authorization')?.replace(/^Bearer /, '') ?? '',
      serverKey,
      this.docName,
    );
    if (!claims || claims.userId !== SERVER_IDENTITY) {
      return new Response('unauthenticated', { status: 401 });
    }

    // The room name is the docName (clients connect at /parties/main/<docName>).
    const doc = this.liveDoc ?? new Y.Doc();

    if (request.method === 'GET') {
      const mode = request.headers.get('x-collab-return') ?? 'update';
      if (mode === 'text') {
        return new Response(this.extractText(doc), {
          headers: { 'content-type': 'text/plain; charset=utf-8' },
        });
      }
      return new Response(Y.encodeStateAsUpdate(doc), {
        headers: { 'content-type': 'application/octet-stream' },
      });
    }

    if (request.method === 'POST') {
      // Restore: apply the update/snapshot posted by Adonis to the live doc.
      const update = new Uint8Array(await request.arrayBuffer());
      Y.applyUpdate(doc, update);
      return new Response(null, { status: 204 });
    }

    return new Response('method not allowed', { status: 405 });
  }

  private extractText(doc: Y.Doc): string {
    let text = '';
    const fragment = doc.getXmlFragment('default');
    for (const block of fragment.toArray()) {
      text += `${block.toString()}\n\n`;
    }
    return text.trimEnd();
  }

  /**
   * The room name identifies the document — same value used in the ?doc=
   * query of REST routes and by the client hooks.
   */
  private get docName(): string {
    return this.party.name;
  }

  /**
   * The secret sent to Adonis in `x-collab-worker-secret`: derived from
   * COLLAB_JWT_SECRET, unless COLLAB_WORKER_SECRET is set (to match an
   * explicit `partykit.workerSecret` in Adonis). A COLLAB_WORKER_SECRET equal
   * to the JWT secret — what older templates asked for — is ignored: the
   * signing key never leaves the worker.
   */
  private async workerSecret(): Promise<string> {
    const jwtSecret = (this.party.env.COLLAB_JWT_SECRET as string | undefined) ?? '';
    const explicit = this.party.env.COLLAB_WORKER_SECRET as string | undefined;
    if (explicit && explicit !== jwtSecret) return explicit;
    if (explicit && !warnedLegacyWorkerSecret) {
      warnedLegacyWorkerSecret = true;
      console.warn(
        '[collab-worker] COLLAB_WORKER_SECRET equals COLLAB_JWT_SECRET and is ignored — the worker secret is now ' +
          'derived from COLLAB_JWT_SECRET. Remove it: npx partykit secret delete COLLAB_WORKER_SECRET',
      );
    }
    return jwtSecret ? deriveKey(jwtSecret, WORKER_SECRET_LABEL) : '';
  }

  private async fetchFromAdonis(
    path: string,
    init?: { method: 'POST'; body: Uint8Array },
  ): Promise<Response> {
    const base = this.party.env.ADONIS_BASE_URL as string;
    const url = `${base}${path}?doc=${encodeURIComponent(this.docName)}`;
    const workerSecret = await this.workerSecret();
    // Reads authenticate with a short-lived token bound to this room; the
    // write (persist) sends the worker secret itself.
    const headers: Record<string, string> = init?.body
      ? { 'x-collab-worker-secret': workerSecret, 'content-type': 'application/octet-stream' }
      : { authorization: `Bearer ${await signWorkerToken(workerSecret, this.docName)}` };
    return fetch(url, {
      method: init?.method ?? 'GET',
      headers,
      body: init?.body ? (init.body as unknown as ArrayBufferView) : undefined,
    });
  }
}
