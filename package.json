{
  "name": "adonis-collaboration",
  "version": "0.1.0",
  "private": true,
  "description": "Collaborative editing (CRDT) for AdonisJS 7 — Yjs (Hocuspocus) and Automerge drivers, Redis-backed presence, unified version control. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-collaboration.git"
  },
  "author": "Davi Carvalho <davi@goflip.ai>",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "pnpm --filter './packages/*' build && changeset publish",
    "version-packages": "changeset version && biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "knex": "^3.3.0",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
